# Copy to .env (next to docker-compose.yml) and fill in.
# `.env` is gitignored; do not commit secrets.

# Required: bearer token for the HTTP+SSE bridge. Generate one with
#   openssl rand -base64 32
BROWSER_MCP_HTTP_TOKEN=

# Optional: tool-surface mode (default "full"). Set BROWSER_MCP_GATEWAY=1 to
# advertise only 3 meta-tools (tools_catalog / tool_schema / tools_invoke),
# or BROWSER_MCP_SLIM=1 for a 5-tool subset. See docs/COMPARISON.md.
# BROWSER_MCP_GATEWAY=1
# BROWSER_MCP_SLIM=1
