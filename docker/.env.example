# Copy to .env (next to docker-compose.yml) and fill in.
# `.env` is gitignored; do not commit secrets.

# Required: bearer token for the HTTP+SSE bridge. Generate one with
#   openssl rand -base64 32
# (The legacy name BROWSER_MCP_HTTP_TOKEN is still honored as a fallback.)
LEAN_CHRONOSCOPE_HTTP_TOKEN=

# Optional: tool-surface mode (default "full"). Set LEAN_CHRONOSCOPE_GATEWAY=1 to
# advertise only 3 meta-tools (tools_catalog / tool_schema / tools_invoke),
# or LEAN_CHRONOSCOPE_SLIM=1 for a 5-tool subset. See docs/COMPARISON.md.
# LEAN_CHRONOSCOPE_GATEWAY=1
# LEAN_CHRONOSCOPE_SLIM=1
